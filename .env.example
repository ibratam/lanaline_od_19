# Node.js Environment
NODE_ENV=development
PORT=3000
HOST=localhost

# Middleware Configuration
MIDDLEWARE_SECRET_KEY=your_secret_key_here_min_32_chars
DB_PATH=./data/middleware.db
LOG_LEVEL=info

# Optional: Odoo RPC tuning (batching + timeout)
ODOO_READ_BATCH_SIZE=4000
ODOO_SEARCH_READ_BATCH_SIZE=4000
ODOO_READ_CONCURRENCY=2
ODOO_RPC_TIMEOUT_MS=60000
ODOO_AUTH_RETRY=3
ODOO_AUTH_RETRY_DELAY_MS=500

# Optional: Incremental sync tuning
ODOO_WRITE_DATE_WINDOW_MINUTES=60
ODOO_INCREMENTAL_TARGET_MODE=full

# Optional: Reduce res.partner fields read (comma-separated)
ODOO_RES_PARTNER_FIELDS=name,email,vat,ref,company_id,street,street2,zip,city,country_id,state_id,phone,mobile

# Optional: Restrict model sync/listing (comma-separated). If unset, all discovered models are eligible.
# ODOO_ALLOWED_MODELS=res.partner,product.product,sale.order

# Optional: Odoo Default Connection (can be overridden in UI)
# ODOO_SOURCE_URL=https://source.odoo.com
# ODOO_SOURCE_DB=odoo_source
# ODOO_TARGET_URL=https://target.odoo.com
# ODOO_TARGET_DB=odoo_target

{
  "name": "odoo-sync-middleware",
  "version": "1.0.0",
  "description": "Middleware for synchronizing two Odoo 19 databases with conflict detection and rollback capability",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --no-coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --no-coverage",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix"
  },
  "keywords": [
    "odoo",
    "synchronization",
    "middleware",
    "database",
    "conflict-detection"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "better-sqlite3": "^11.5.0",
    "sqlite3": "^5.1.7",
    "node-cron": "^3.0.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.3",
    "eslint": "^8.57.1",
    "@babel/preset-env": "^7.24.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
